{
  "name": "ci-cd-demo",
  "version": "1.0.0",
  "description": "Aplicacion de ejemplo para demostrar pipelines de CI/CD con GitHub Actions - Programacion IV, UNA",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "lint": "eslint src tests --ext .js",
    "test": "jest --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
